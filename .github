name: Make gitartwork SVG

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    name: Generate and commit gitartwork.svg
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
        with:
          persist-credentials: true
          fetch-depth: 0

      - name: Generate gitartwork.svg
        uses: jasineri/gitartwork@v1
        with:
          # Use your GitHub username's contribution graph
          user_name: pronoy656
          # Text overlaid on the contribution graph (change as you like)
          text: PRONOY

      - name: Commit and push generated SVG
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add gitartwork.svg
          if git diff --cached --quiet; then
            echo "No changes to commit"
          else
            git commit -m "chore: update gitartwork.svg"
            git push
          fi
